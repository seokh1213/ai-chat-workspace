# Pin the Node2Shell (CVE-2026-111497) fixed release; a bare tag keeps whatever the builder cached.
FROM node:26.13.0-trixie-slim@sha256:e4db4c914bf8ad241bd24804fc25d272d89bad97e68cdc8a1414862790a02c39

ARG CODEX_VERSION=0.166.0

RUN apt-get update \
  && apt-get install -y --no-install-recommends bubblewrap ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g "@openai/codex@${CODEX_VERSION}" \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
       /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
  && useradd --create-home --home-dir /ai-chat --shell /bin/bash codex \
  && mkdir -p /ai-chat/.codex \
  && chown -R codex:codex /ai-chat

USER codex
WORKDIR /ai-chat

ENV HOME=/ai-chat
ENV CODEX_HOME=/ai-chat/.codex

EXPOSE 8765

# A non-loopback listener only starts with auth; mount the token shared with the app at this path.
ENTRYPOINT ["codex", "app-server", "--listen", "ws://0.0.0.0:8765", \
  "--ws-auth", "capability-token", "--ws-token-file", "/run/secrets/codex-ws/token"]
