# Pin the Node2Shell (CVE-2026-111497) fixed release; a bare tag keeps whatever the builder cached.
FROM node:22.23.4-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d

ARG CODEX_VERSION=0.128.0

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g "@openai/codex@${CODEX_VERSION}" \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
       /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
  && useradd --create-home --home-dir /ai-chat --shell /bin/bash codex \
  && mkdir -p /ai-chat/.codex \
  && chown -R codex:codex /ai-chat

USER codex
WORKDIR /ai-chat

ENV HOME=/ai-chat
ENV CODEX_HOME=/ai-chat/.codex

EXPOSE 8765

ENTRYPOINT ["codex", "app-server", "--listen", "ws://0.0.0.0:8765"]
